#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <string.h>
#include <time.h>

int main() {
    int pipefd[2];
    char buffer[100];

    if (pipe(pipefd) == -1) {
        printf("Pipe creation failed\n");
        return 1;
    }

    pid_t pid = fork();

    if (pid > 0) {
        // Parent process: Producer
        close(pipefd[0]);

        char *data = "Hello from Producer";
        clock_t start = clock();

        write(pipefd[1], data, strlen(data) + 1);
        close(pipefd[1]);

        wait(NULL);

        clock_t end = clock();

        printf("Producer: Data sent = %s\n", data);
        printf("Communication time: %.6f seconds\n",
               (double)(end - start) / CLOCKS_PER_SEC);

    } else if (pid == 0) {
        // Child process: Consumer
        close(pipefd[1]);

        read(pipefd[0], buffer, sizeof(buffer));
        printf("Consumer: Data received = %s\n", buffer);

        close(pipefd[0]);

    } else {
        printf("Fork failed\n");
        return 1;
    }

    return 0;
}
