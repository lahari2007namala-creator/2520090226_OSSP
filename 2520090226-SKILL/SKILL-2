#include <stdio.h>
#include <string.h>

#define MAX 100

int main()
{
    char input[MAX];

    while (1)
    {
        printf("myshell> ");
        fflush(stdout);

        if (fgets(input, MAX, stdin) == NULL)
            break;

        input[strcspn(input, "\n")] = '\0';

        if (strcmp(input, "exit") == 0)
        {
            printf("Exiting Shell...\n");
            break;
        }

        if (strlen(input) == 0)
        {
            continue;
        }

        printf("You Entered: %s\n", input);
    }

    return 0;
}
