Code 7 — wait() Program

#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    pid_t pid = fork();

    if (pid == 0)
    {
        printf("Child started. PID = %d\n", getpid());
        sleep(2);
        printf("Child completed.\n");
    }
    else
    {
        printf("Parent waiting for child...\n");

        wait(NULL);

        printf("Child finished. Parent continuing.\n");
    }

    return 0;
}

Code 8 — waitpid() Program

#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    pid_t pid = fork();

    if (pid == 0)
    {
        printf("Child PID = %d\n", getpid());
        sleep(2);
        printf("Child completed\n");
    }
    else
    {
        printf("Parent PID = %d\n", getpid());
        printf("Parent waiting for child %d...\n", pid);

        waitpid(pid, NULL, 0);

        printf("Child %d completed. Parent continuing.\n", pid);
    }

    return 0;
}

