#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main() {
    pid_t child1, child2, child3;
    int status;

    child1 = fork();

    if (child1 == 0) {
        printf("Child 1 started. PID: %d\n", getpid());
        sleep(3);
        printf("Child 1 completed.\n");
        exit(1);
    }

    child2 = fork();

    if (child2 == 0) {
        printf("Child 2 started. PID: %d\n", getpid());
        sleep(1);
        printf("Child 2 completed.\n");
        exit(2);
    }

    child3 = fork();

    if (child3 == 0) {
        printf("Child 3 started. PID: %d\n", getpid());
        sleep(2);
        printf("Child 3 completed.\n");
        exit(3);
    }

    printf("Parent PID: %d\n", getpid());

    /*
     * waitpid() waits for a specific child.
     * Here, the parent waits specifically for Child 1.
     */
    waitpid(child1, &status, 0);

    if (WIFEXITED(status)) {
        printf("Parent collected Child 1. Exit status: %d\n",
               WEXITSTATUS(status));
    }

    /*
     * wait() waits for any completed child.
     */
    pid_t completedChild;

    while ((completedChild = wait(&status)) > 0) {
        if (WIFEXITED(status)) {
            printf("Parent collected child PID %d. Exit status: %d\n",
                   completedChild,
                   WEXITSTATUS(status));
        }
    }

    printf("All child processes completed.\n");

    return 0;
}
